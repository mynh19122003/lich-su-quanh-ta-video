  {
   "id": "ll91m6jt",
   "kind": "text",
   "name": "Phụ đề",
   "items": [
    {
     "id": "wteg6i1j",
     "type": "text",
     "from": 1955,
     "durationInFrames": 73,
     "x": 960,
     "y": 990,
     "text": "Trong lúc đó, ở bên kia Thái Bình Dương,",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "zp38dt4w",
     "type": "text",
     "from": 2028,
     "durationInFrames": 104,
     "x": 960,
     "y": 990,
     "text": "nước Mỹ đang rất lo lắng về một thứ gọi là thuyết Đôminô.",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "lt28qk3q",
     "type": "text",
     "from": 2143,
     "durationInFrames": 147,
     "x": 960,
     "y": 990,
     "text": "Nếu Đông Dương theo cộng sản, cả Đông Nam Á sẽ đổ theo như những quân",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "pi368i8g",
     "type": "text",
     "from": 2290,
     "durationInFrames": 24,
     "x": 960,
     "y": 990,
     "text": "bài đôminô!",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "5so3nky3",
     "type": "text",
     "from": 2325,
     "durationInFrames": 73,
     "x": 960,
     "y": 990,
     "text": "Vì vậy Mỹ quyết định rút ví.",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "mij1m02p",
     "type": "text",
     "from": 2398,
     "durationInFrames": 175,
     "x": 960,
     "y": 990,
     "text": "Đến năm 1954, Mỹ gánh gần 80% chi phí chiến tranh của Pháp ở Đông Dương.",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "s5zdrbmr",
     "type": "text",
     "from": 2585,
     "durationInFrames": 65,
     "x": 960,
     "y": 990,
     "text": "Merci, anh bạn.",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "gyv2bmxe",
     "type": "text",
     "from": 2661,
     "durationInFrames": 107,
     "x": 960,
     "y": 990,
     "text": "Nói cách khác: Pháp đánh, còn Mỹ trả tiền.",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    }
   ]
  },
  {
   "id": "8yzj0m71",
   "kind": "text",
   "name": "Phụ đề",
   "items": [
    {
     "id": "pw04pm3u",
     "type": "text",
     "from": 18,
     "durationInFrames": 102,
     "x": 960,
     "y": 990,
     "text": "Năm 1954, quân và dân Việt Nam vừa thắng một trận lớn,",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "z9l6uyo5",
     "type": "text",
     "from": 120,
     "durationInFrames": 130,
     "x": 960,
     "y": 990,
     "text": "đúng lúc cả thế giới đang ngồi lại với nhau để họp bàn về Đông Dương.",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "dofdat07",
     "type": "text",
     "from": 261,
     "durationInFrames": 113,
     "x": 960,
     "y": 990,
     "text": "Và kết quả của cuộc họp đó là... đất nước bị chia làm đôi.",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "bqubxdll",
     "type": "text",
     "from": 402,
     "durationInFrames": 47,
     "x": 960,
     "y": 990,
     "text": "Khoan đã.",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "8gawg1vd",
     "type": "text",
     "from": 449,
     "durationInFrames": 67,
     "x": 960,
     "y": 990,
     "text": "Thắng trận mà lại bị chia đôi?",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "5aqd5h5j",
     "type": "text",
     "from": 516,
     "durationInFrames": 77,
     "x": 960,
     "y": 990,
     "text": "Nghe có gì đó sai sai đúng không?",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "cklah5kw",
     "type": "text",
     "from": 606,
     "durationInFrames": 109,
     "x": 960,
     "y": 990,
     "text": "Để hiểu chuyện này, chúng ta phải quay lại phòng họp ở Giơnevơ,",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    },
    {
     "id": "xq456ykb",
     "type": "text",
     "from": 715,
     "durationInFrames": 58,
     "x": 960,
     "y": 990,
     "text": "và cả những năm tháng sau đó nữa.",
     "fontFamily": "Arial",
     "fontSize": 46,
     "color": "#ffffff",
     "strokeColor": "#000000",
     "strokeWidth": 0,
     "bold": false,
     "background": "rgba(0,0,0,0.75)",
     "opacity": 1
    }
   ]
  },
